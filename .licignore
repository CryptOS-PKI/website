# GoLic ignore file -- https://github.com/Bugs5382/golic
# Ignore everything...
*

# ...but inject the Apache 2.0 header into these source types:
!*.ts
!*.tsx
!*.js
!*.mjs
!*.mts
!*.cjs
!*.cts

# ...even when they live in subdirectories:
!*/

# Never the build output, deps, caches, or generated types:
/node_modules/**
**/node_modules/**
/build/**
**/build/**
/.react-router/**
**/.react-router/**
/coverage/**
**/coverage/**
